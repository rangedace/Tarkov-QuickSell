<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>QuickSell</AssemblyName>
    <RootNamespace>QuickSell</RootNamespace>
    <Deterministic>true</Deterministic>
    <SPTPath Condition="'$(SPTPath)' == ''">D:\SPT</SPTPath>
    <InstallAfterBuild Condition="'$(InstallAfterBuild)' == ''">false</InstallAfterBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />

    <Reference Include="0Harmony" HintPath="$(SPTPath)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SPTPath)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="spt-common" HintPath="$(SPTPath)\BepInEx\plugins\spt\spt-common.dll" Private="false" />
    <Reference Include="spt-reflection" HintPath="$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll" Private="false" />

    <Reference Include="Assembly-CSharp" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="CommonExtensions" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\CommonExtensions.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll" Private="false" />
    <Reference Include="DOTween" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\DOTween.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll')"
           Text="SPT introuvable dans '$(SPTPath)'. Définissez /p:SPTPath=CHEMIN_VERS_SPT." />
  </Target>

  <Target Name="InstallPlugin" AfterTargets="Build" Condition="'$(InstallAfterBuild)' == 'true'">
    <MakeDir Directories="$(SPTPath)\BepInEx\plugins\QuickSell" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)config.json"
          DestinationFolder="$(SPTPath)\BepInEx\plugins\QuickSell" />
  </Target>
</Project>
